\u003cp\u003eOlá {{user.available_name}},\u003c/p\u003e

\u003cp style=\"color: #374151; line-height: 1.6;\"\u003e
  Você foi mencionado na conversa (\u003ca href=\"{{ action_url }}\" style=\"color: #7C3AED; text-decoration: none; font-weight: 600;\"\u003e#{{conversation.display_id}}\u003c/a\u003e).
\u003c/p\u003e

{% if message %}
  \u003cdiv style=\"margin: 20px 0;\"\u003e
    \u003ch4 style=\"margin: 0 0 8px 0; color: #6B7280; font-size: 14px; font-weight: 600;\"\u003e
      {{ message.sender_display_name }}
    \u003c/h4\u003e

    \u003cdiv style=\"padding: 12px 16px; margin: 0; background: #FEF3C7; border-left: 3px solid #F59E0B; border-radius: 6px; font-family: 'Helvetica Neue',Tahoma,Arial,sans-serif; color: #374151; line-height: 1.6;\"\u003e
      {% if message.text_content %}
        {{ message.text_content }}
      {% endif %}

      {% if message.attachments %}
        {% for attachment in message.attachments %}
          \u003cbr/\u003e\u003cbr/\u003e
          📎 Anexo [\u003ca href=\"{{ attachment.download_url }}\" target=\"_blank\" style=\"color: #F59E0B; text-decoration: none; font-weight: 600;\"\u003eClique aqui para visualizar\u003c/a\u003e]
        {% endfor %}
      {% endif %}
    \u003c/div\u003e
  \u003c/div\u003e
{% endif %}

\u003cp style=\"margin-top: 24px;\"\u003e
  \u003ca href=\"{{ action_url }}\" style=\"display: inline-block; padding: 12px 24px; background-color: #7C3AED; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600; text-align: center;\"\u003e
    Responder
  \u003c/a\u003e
\u003c/p\u003e
