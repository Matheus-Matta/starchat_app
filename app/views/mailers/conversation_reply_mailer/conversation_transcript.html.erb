<%
  contact_attrs = @contact.additional_attributes || {}
  contact_company = @contact.company&.name || contact_attrs['company_name']
  contact_city_country = [contact_attrs['city'], contact_attrs['country']].compact_blank.join(', ')
  contact_labels = @contact.label_list.join(', ')
%>

<!-- Contact details -->
<tr>
  <td style="padding: 0 0 16px 0;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td>
          <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #374151;">Dados do contato</p>
          <p style="margin: 0; font-size: 12px; color: #4b5563; line-height: 18px;">
            <b>Nome:</b> <%= @contact.name %><br>
            <% if @contact.email.present? %><b>E-mail:</b> <%= @contact.email %><br><% end %>
            <% if @contact.phone_number.present? %><b>Telefone:</b> <%= @contact.phone_number %><br><% end %>
            <% if contact_company.present? %><b>Empresa:</b> <%= contact_company %><br><% end %>
            <% if contact_city_country.present? %><b>Cidade/País:</b> <%= contact_city_country %><br><% end %>
            <% if contact_attrs['description'].present? %><b>Descrição:</b> <%= contact_attrs['description'] %><br><% end %>
            <% if contact_labels.present? %><b>Etiquetas:</b> <%= contact_labels %><br><% end %>
            <% if @contact.created_at.present? %><b>Criado em:</b> <%= @contact.created_at.strftime('%d/%m/%Y %H:%M') %><br><% end %>
            <% if @contact.last_activity_at.present? %><b>Última atividade:</b> <%= @contact.last_activity_at.strftime('%d/%m/%Y %H:%M') %><% end %>
          </p>
        </td>
      </tr>
    </table>
  </td>
</tr>

<% @messages.each do |message| %>
  <tr>
    <td>
      <b><%= message.sender&.try(:available_name) || message.sender&.name || '' %></b>
      <% if message.conversation.inbox&.inbox_type == 'Email' %>
        <div style="font-size: 90%; color: #899096; line-height: 16px">
          <% if message.content_attributes.dig(:email, :from).present? %>
            <div>From: <%= message.content_attributes.dig(:email, :from).join(", ") %></div>
          <% else %>
            <div>From: <%= message.sender&.try(:email) %></div>
          <% end %>

          <% if message.content_attributes.dig(:email, :subject).present? %>
            <div>Subject: <%= message.content_attributes.dig(:email, :subject) %></div>
          <% end %>

          <% if message.content_attributes[:to_emails].present? %>
            <div>To: <%= message.content_attributes[:to_emails].join(", ") %></div>
          <% end %>
          <% if message.content_attributes[:cc_emails].present? %>
            <div>CC: <%= message.content_attributes[:cc_emails].join(", ") %></div>
          <% end %>
          <% if message.content_attributes[:bcc_emails].present? %>
            <div>BCC: <%= message.content_attributes[:bcc_emails].join(", ") %></div>
          <% end %>
        </div>
      <% end %>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 32px;">
      <% if message.content %>
        <%= ChatwootMarkdownRenderer.new(message.content).render_message %>
      <% end %>
      <% if message.attachments.present? %>
        <p>Attachments:</p>
        <% message.attachments.each do |attachment| %>
          <p><a href="<%= attachment.file_url %>" target="_blank"><%= attachment.file.filename.to_s %></a></p>
        <% end %>
      <% end %>
      <p style="font-size: 90%; font-size: 90%;color: #899096;margin-top: -8px; margin-bottom: 0px;">
      <% if @inbox.timezone.present? %>
        <%= message.created_at.in_time_zone(@inbox.timezone).strftime('%b %d, %I:%M %p %Z') %>
      <% else %>
        <%= message.created_at.strftime('%b %d, %I:%M %p %Z') %>
      <% end %>
      </p>
    </td>
  </tr>
<% end %>
